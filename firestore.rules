rules_version = '2';
// Regras de segurança — Almoxarifado da Piramba
// © 2026 Felippe Alvarez. Todos os direitos reservados.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function membro(casaId) {
      return logado() && request.auth.uid in get(/databases/$(database)/documents/casas/$(casaId)).data.membros;
    }

    // Perfil: cada pessoa só lê e grava o próprio
    match /usuarios/{uid} {
      allow read, write: if logado() && request.auth.uid == uid;
    }

    // Convites: quem sabe o código consegue ler aquele convite (não é possível listar todos)
    match /convites/{codigo} {
      allow get: if logado();
      allow create: if logado() && membro(request.resource.data.casaId);
      allow delete: if logado() && membro(resource.data.casaId);
    }

    match /casas/{casaId} {
      allow read: if logado() && request.auth.uid in resource.data.membros;
      allow create: if logado()
        && request.resource.data.membros == [request.auth.uid]
        && request.resource.data.criadoPor == request.auth.uid;
      allow update: if logado() && (
        // membros podem alterar (limite de 5 pessoas)
        (request.auth.uid in resource.data.membros && request.resource.data.membros.size() <= 5)
        // quem não é membro só pode se incluir (entrar com código), respeitando o limite
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros', 'membrosInfo'])
            && request.resource.data.membros.hasAll(resource.data.membros)
            && request.auth.uid in request.resource.data.membros
            && request.resource.data.membros.size() == resource.data.membros.size() + 1
            && request.resource.data.membros.size() <= 5)
      );
      allow delete: if logado() && resource.data.criadoPor == request.auth.uid;

      // itens, lotes (validades) e movimentações: só membros
      match /{sub}/{docId} {
        allow read, write: if membro(casaId);
      }
    }
  }
}
